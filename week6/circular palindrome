import java.io.*;
import java.util.*;

class Result {

    public static List<Integer> circularPalindromes(String s) {

        int n = s.length();
        List<Integer> result = new ArrayList<>();

        // Double the string to create rotations
        String doubled = s + s;

        for (int start = 0; start < n; start++) {
            String rotation = doubled.substring(start, start + n);
            result.add(longestPalindrome(rotation));
        }

        return result;
    }

    private static int longestPalindrome(String s) {

        int n = s.length();
        int[] d1 = new int[n];
        int[] d2 = new int[n];

        // Odd length palindromes
        int l = 0, r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 1 : Math.min(d1[l + r - i], r - i + 1);

            while (i - k >= 0 && i + k < n &&
                   s.charAt(i - k) == s.charAt(i + k)) {
                k++;
            }

            d1[i] = k--;

            if (i + k > r) {
                l = i - k;
                r = i + k;
            }
        }

        // Even length palindromes
        l = 0;
        r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 0 : Math.min(d2[l + r - i + 1], r - i + 1);

            while (i - k - 1 >= 0 && i + k < n &&
                   s.charAt(i - k - 1) == s.charAt(i + k)) {
                k++;
            }

            d2[i] = k--;

            if (i + k > r) {
                l = i - k - 1;
                r = i + k;
            }
        }

        int max = 1;

        for (int i = 0; i < n; i++) {
            max = Math.max(max, 2 * d1[i] - 1);
            max = Math.max(max, 2 * d2[i]);
        }

        return max;
    }
}

public class Solution {

    public static void main(String[] args) throws Exception {

        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();

        List<Integer> result = Result.circularPalindromes(s);

        for (int x : result) {
            System.out.println(x);
        }
    }
}
